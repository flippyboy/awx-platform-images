# Optional: build AWX controller image from source (HEADLESS — UI lives in ansible-ui).
# Prefer ghcr.io/ansible/awx:devel for faster bring-up; use this for fully local builds.
#
# Build from the controller repo root after generating Dockerfile:
#   cd controller && make Dockerfile HEADLESS=1
#   docker build -f Dockerfile --build-arg HEADLESS=true -t awx-compose/controller:local .
#
# This wrapper documents the intended flow and can be used once a Dockerfile
# has been generated by the AWX Makefile.

ARG AWX_BASE=ghcr.io/ansible/awx:devel
FROM ${AWX_BASE}

# No modifications needed — configuration is injected via compose mounts.
LABEL org.opencontainers.image.title="AWX Controller (compose)" \
      org.opencontainers.image.description="AWX controller image for awx-compose stack" \
      org.opencontainers.image.source="https://github.com/ansible/awx"
